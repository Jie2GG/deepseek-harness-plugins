{
  "name": "@jie2gg/dsh-plugin-ssh",
  "version": "0.10.0",
  "private": true,
  "description": "Runs commands and moves files on stored SSH servers: a settings page for the inventory, and a `remote` tool that hands the model the alias list to choose from.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "ssh",
    "openssh",
    "remote",
    "shell",
    "settings",
    "credentials"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jie2GG/deepseek-harness-plugins.git",
    "directory": "ssh"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-fs": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/finalize-client.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
