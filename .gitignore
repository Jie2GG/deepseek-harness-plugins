# 依赖与构建产物（每个插件目录独立）
node_modules/
lib/
dist/
build/
*.tsbuildinfo

# 测试与覆盖率
coverage/
.nyc_output/

# 日志
*.log
pnpm-debug.log*
npm-debug.log*
yarn-error.log*

# 环境变量与本地配置
.env
.env.local
.env.*.local

# 编辑器 / 系统
.idea/
.vscode/
*.swp
.DS_Store

# 交付产物与审阅归档：版本报告、diff 导出、pack 安装包一律不进版本控制
artifacts/
# 兜底：防止 agent 未遵守规范、把产物散放在插件目录或仓库根
SSH-PLUGIN-*.md
SSH-PLUGIN-*.patch
*.tgz
