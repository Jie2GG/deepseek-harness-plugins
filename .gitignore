# 依赖与构建产物（每个插件目录独立）
node_modules/
lib/
dist/
build/
*.tsbuildinfo

# 测试与覆盖率
coverage/
.nyc_output/

# 日志
*.log
pnpm-debug.log*
npm-debug.log*
yarn-error.log*

# 环境变量与本地配置
.env
.env.local
.env.*.local

# 编辑器 / 系统
.idea/
.vscode/
*.swp
.DS_Store

# 交付产物与审阅归档（见 CONTRIBUTING.md「交付产物与目录卫生」）
# 通用防线：产物只要落进 <plugin>/artifacts/ 就被忽略，与文件名无关；npm pack 的 tarball 一律忽略
artifacts/
*.tgz
# 额外兜底：仅覆盖 ssh 的历史命名（本次清理遗留），防止旧产物被重新散放回仓库
# 注意：其他插件的产物若不进 artifacts/，不会被下面两条名字规则忽略——按位置归档才是通用做法
SSH-PLUGIN-*.md
SSH-PLUGIN-*.patch
